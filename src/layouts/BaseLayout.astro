---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Fruity Coffee Club</title>
    
    <!-- Import Font Kalcer dari Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
  </head>
  
  <!-- Terapkan Space Grotesk sebagai font default bawaan -->
  <body class="bg-[#fff5ec] text-[#5c0617] font-['Space_Grotesk',sans-serif]">
    <slot />
  </body>
</html>