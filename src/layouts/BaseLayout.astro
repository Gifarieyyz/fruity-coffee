---
interface Props {
  title?: string;
}

const { title = "Fruity Coffee Club 🍍" } = Astro.props;
import '../styles/global.css'; // atau lokasi file CSS/Tailwind lu
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <!-- Netlify Identity Widget -->
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  </head>
  <body class="bg-[#fff5ec] text-[#5c0617] font-sans">
    <slot />
  </body>
</html>