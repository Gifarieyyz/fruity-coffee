---
interface Props {
  title?: string;
}

const { title = "Fruity Coffee Club" } = Astro.props;
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="description" content="Fruity Coffee Club — catatan beans dan resep manual brew." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Fredoka+One&family=Space+Grotesk:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-[#fff5ec] text-[#5c0617] font-sans">
    <slot />
  </body>
</html>