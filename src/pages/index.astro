---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import { getCollection } from 'astro:content';

const allBeans = await getCollection('beans');
const allRecipes = await getCollection('recipes');
---

<BaseLayout title="Home">
  <div id="loader-overlay" class="fixed inset-0 z-[9999] bg-[#5c0617] flex items-center justify-center transition-transform duration-800 ease-[cubic-bezier(0.87,0,0.13,1)] select-none">
    <div id="pineapple-mascot" class="relative flex items-center justify-center transition-transform duration-500 scale-90 cursor-pointer">
      <img src="/pineapple.webp" alt="Pineapple Mascot" loading="eager" fetchpriority="high" class="w-28 h-28 md:w-40 md:h-40 filter drop-shadow-[0_10px_20px_rgba(0,0,0,0.4)] animate-bounce" />
    </div>
  </div>

  <Navbar />
  
  <main 
    class="min-h-screen w-full bg-cover bg-center bg-no-repeat relative flex items-center justify-center overflow-hidden custom-cursor"
    style="background-image: url('/bg1.webp');"
  >
    <div class="absolute inset-0 bg-black/30 z-0 pointer-events-none"></div>

    <div class="absolute top-28 left-8 md:left-16 z-20 animate-float pointer-events-auto">
      <div class="sticker-pop bg-[#ecec53] text-[#5c0617] border-4 border-[#5c0617] font-black px-4 py-2 rounded-2xl -rotate-12 shadow-[4px_4px_0px_#5c0617] cursor-pointer text-sm md:text-base select-none">
        100% JUICY! 🍍
      </div>
    </div>

    <div class="absolute bottom-32 right-8 md:right-20 z-20 animate-float-delayed pointer-events-auto">
      <div class="sticker-pop bg-[#e05263] text-white border-4 border-[#5c0617] font-black px-4 py-2 rounded-2xl rotate-12 shadow-[4px_4px_0px_#5c0617] cursor-pointer text-sm md:text-base select-none">
        SWEET & ACIDIC 🍋
      </div>
    </div>

    <h1 id="hi-there-text" class="relative z-10 text-white text-7xl md:text-[8rem] font-bold drop-shadow-2xl lowercase select-none transition-all duration-75 scale-100 opacity-100">
      hi there.
    </h1>

    <a href="#beans-section" class="sfx-trigger absolute bottom-12 left-1/2 -translate-x-1/2 z-20 text-white opacity-80 hover:opacity-100 hover:text-[#ecec53] hover:scale-125 transition-all duration-300 animate-bounce cursor-pointer">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-10 h-10 md:w-12 md:h-12 drop-shadow-md">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
      </svg>
    </a>
  </main>

  <div class="overflow-hidden border-t-4 border-[#5c0617] bg-[#ecec53] py-3 flex items-center select-none w-full">
    <div class="marquee-track flex whitespace-nowrap">
      <div class="marquee-group flex gap-12 font-['Space_Grotesk',sans-serif] font-bold text-xl md:text-2xl text-[#5c0617] tracking-widest uppercase pr-12">
        <span>FRUITY COFFEE CLUB 🍍</span>
        <span>MANUAL BREW DAILY 🍓</span>
        <span>SWEET & JUICY 🍇</span>
        <span>BRIGHT ACIDITY 🍋</span>
        <span>NO ROASTY BITS 🍒</span>
      </div>
      <div class="marquee-group flex gap-12 font-['Space_Grotesk',sans-serif] font-bold text-xl md:text-2xl text-[#5c0617] tracking-widest uppercase pr-12" aria-hidden="true">
        <span>FRUITY COFFEE CLUB 🍍</span>
        <span>MANUAL BREW DAILY 🍓</span>
        <span>SWEET & JUICY 🍇</span>
        <span>BRIGHT ACIDITY 🍋</span>
        <span>NO ROASTY BITS 🍒</span>
      </div>
    </div>
  </div>

  <section id="beans-section" class="min-h-screen border-t-4 border-[#5c0617] py-20 flex flex-col justify-center polkadot-bg relative overflow-hidden custom-cursor">
    <div class="absolute top-10 right-10 z-20 animate-float hidden md:block">
      <div class="sticker-pop bg-[#fff5ec] text-[#5c0617] border-4 border-[#5c0617] font-black px-4 py-2 rounded-2xl rotate-6 shadow-[4px_4px_0px_#5c0617] cursor-pointer select-none">
        HOT BREW ☕
      </div>
    </div>

    <div class="anim-on-scroll px-6 md:px-20 mb-4">
      <h2 class="font-['DM_Serif_Display',serif] text-5xl md:text-7xl text-[#5c0617] mb-4 hover:translate-x-2 transition-transform duration-300 cursor-default">
        Recent Brews
      </h2>
      <p class="font-['Space_Grotesk',sans-serif] text-lg font-bold text-[#e05263] uppercase tracking-widest">
        Geser & klik untuk detail beans ➔
      </p>
    </div>

    <div 
      id="beans-carousel" 
      class="anim-on-scroll flex overflow-x-auto snap-x snap-mandatory gap-6 md:gap-12 px-[15vw] md:px-[40vw] py-12 hide-scrollbar w-full items-center cursor-grab active:cursor-grabbing scroll-smooth"
    >
      {allBeans.map((bean, i) => (
        <div 
          class={`bean-card sfx-trigger snap-center shrink-0 w-[290px] md:w-[370px] bg-[#fff5ec] border-4 border-[#5c0617] rounded-[2.5rem] p-6 md:p-8 cursor-pointer transition-all duration-300 ease-out flex flex-col justify-between ${i % 2 === 0 ? 'hover:-rotate-2' : 'hover:rotate-2'}`}
          data-name={bean.data.name}
          data-origin={bean.data.origin}
          data-process={bean.data.process}
          data-roaster={bean.data.roaster}
          data-notes={bean.data.notes}
          data-review={bean.body}
        >
          <div>
            <div class="bg-[#ecec53] text-[#5c0617] text-xs font-bold px-4 py-1.5 rounded-full w-fit mb-6 border-2 border-[#5c0617] transition-transform duration-300 hover:scale-110">
              {bean.data.roaster}
            </div>
            <h3 class="font-['DM_Serif_Display',serif] text-3xl md:text-4xl leading-tight mb-4 text-[#5c0617]">
              {bean.data.name}
            </h3>
          </div>
          <div class="mt-8 border-t-2 border-[#5c0617]/20 pt-4">
            <span class="font-['Space_Grotesk',sans-serif] font-bold text-xs uppercase tracking-widest text-[#5c0617] block mb-1">Notes:</span>
            <p class="font-bold text-[#e05263] text-sm md:text-base">{bean.data.notes}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="anim-on-scroll flex justify-center gap-6 mt-6 z-20">
      <button id="beans-prev" class="btn-playful sfx-trigger bg-[#fff5ec] text-[#5c0617] border-4 border-[#5c0617] w-12 h-12 md:w-14 md:h-14 rounded-full font-black shadow-[4px_4px_0px_#5c0617] hover:bg-[#ecec53] hover:translate-y-1 hover:shadow-none transition-all flex items-center justify-center cursor-pointer select-none">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
      </button>
      <button id="beans-next" class="btn-playful sfx-trigger bg-[#fff5ec] text-[#5c0617] border-4 border-[#5c0617] w-12 h-12 md:w-14 md:h-14 rounded-full font-black shadow-[4px_4px_0px_#5c0617] hover:bg-[#ecec53] hover:translate-y-1 hover:shadow-none transition-all flex items-center justify-center cursor-pointer select-none">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </button>
    </div>
  </section>

  <div class="overflow-hidden border-t-4 border-[#5c0617] bg-[#fff5ec] py-3 flex items-center select-none w-full">
    <div class="marquee-track-reverse flex whitespace-nowrap">
      <div class="marquee-group flex gap-12 font-['Space_Grotesk',sans-serif] font-bold text-xl md:text-2xl text-[#5c0617] tracking-widest uppercase pr-12">
        <span>POUR OVER ENTHUSIAST ☕</span>
        <span>HARIO SWITCH 🍎</span>
        <span>TIMEMORE S3 🍊</span>
        <span>FRUITY COFFEE CLUB 🍍</span>
        <span>LIGHT ROAST ONLY 🍑</span>
      </div>
      <div class="marquee-group flex gap-12 font-['Space_Grotesk',sans-serif] font-bold text-xl md:text-2xl text-[#5c0617] tracking-widest uppercase pr-12" aria-hidden="true">
        <span>POUR OVER ENTHUSIAST ☕</span>
        <span>HARIO SWITCH 🍎</span>
        <span>TIMEMORE S3 🍊</span>
        <span>FRUITY COFFEE CLUB 🍍</span>
        <span>LIGHT ROAST ONLY 🍑</span>
      </div>
    </div>
  </div>

  <section 
    id="gear-section" 
    class="min-h-screen md:min-h-[115vh] bg-[#fff5ec] border-t-4 border-[#5c0617] py-12 md:py-20 px-4 md:px-12 relative overflow-hidden flex flex-col justify-between custom-cursor bg-cover bg-bottom bg-no-repeat"
    style="background-image: url('/bg2.webp');"
  >
    <div class="anim-on-scroll w-full max-w-[1500px] h-[75vh] md:h-[680px] mx-auto relative block my-auto">
      
      <div class="gear-item group sfx-trigger absolute left-[5%] top-[8%] md:left-[2%] md:top-[4%] w-[140px] md:w-[240px] lg:w-[280px] cursor-pointer z-10 animate-float">
        <div class="relative transition-all duration-500 ease-out group-hover:scale-115 group-hover:rotate-0 -rotate-12">
          <img src="/timemore.webp" alt="Timemore S3" loading="lazy" decoding="async" class="w-full h-auto filter drop-shadow-[0_15px_25px_rgba(0,0,0,0.35)] select-none" />
          <span class="absolute top-[8%] right-[10px] bg-[#5c0617] text-[#ecec53] text-sm font-black w-9 h-9 rounded-full flex items-center justify-center border-2 border-[#fff5ec] shadow-lg transition-all duration-300 group-hover:scale-125 group-hover:bg-[#e05263] group-hover:rotate-12">
            1
          </span>
        </div>
        <div class="absolute -bottom-10 left-0 opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none z-30 group-hover:translate-y-1">
          <span class="bg-[#5c0617] text-[#ecec53] font-['Space_Grotesk',sans-serif] text-xs md:text-sm font-bold px-4 py-2 rounded-xl border-2 border-[#ecec53] whitespace-nowrap shadow-[4px_4px_0px_#5c0617]">
            Timemore Chestnut S3 (Manual Grinder)
          </span>
        </div>
      </div>

      <div class="gear-item group sfx-trigger absolute right-[5%] top-[28%] md:right-auto md:left-[34%] md:top-[12%] w-[160px] md:w-[260px] lg:w-[310px] cursor-pointer z-10 animate-float-delayed">
        <div class="relative transition-all duration-500 ease-out group-hover:scale-115 group-hover:rotate-0 rotate-6">
          <img src="/mugen.webp" alt="Hario Switch & Mugen" loading="lazy" decoding="async" class="w-full h-auto filter drop-shadow-[0_15px_25px_rgba(0,0,0,0.35)] select-none" />
          <span class="absolute top-[5%] right-[15px] bg-[#5c0617] text-[#ecec53] text-sm font-black w-9 h-9 rounded-full flex items-center justify-center border-2 border-[#fff5ec] shadow-lg transition-all duration-300 group-hover:scale-125 group-hover:bg-[#e05263] group-hover:rotate-12">
            2
          </span>
        </div>
        <div class="absolute -bottom-10 right-0 md:left-1/2 md:-translate-x-1/2 md:right-auto opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none z-30 group-hover:translate-y-1">
          <span class="bg-[#5c0617] text-[#ecec53] font-['Space_Grotesk',sans-serif] text-xs md:text-sm font-bold px-4 py-2 rounded-xl border-2 border-[#ecec53] whitespace-nowrap shadow-[4px_4px_0px_#5c0617]">
            Hario Switch + Mugen Dripper
          </span>
        </div>
      </div>

      <div class="gear-item group sfx-trigger absolute left-[10%] bottom-[25%] md:left-auto md:right-[2%] md:top-[3%] md:bottom-auto w-[130px] md:w-[240px] lg:w-[280px] cursor-pointer z-10 animate-float">
        <div class="relative transition-all duration-500 ease-out group-hover:scale-115 group-hover:rotate-0 rotate-12">
          <img src="/paper.webp" alt="Cafec Abaca Paper" loading="lazy" decoding="async" class="w-full h-auto filter drop-shadow-[0_15px_25px_rgba(0,0,0,0.35)] select-none" />
          <span class="absolute top-[10px] right-[10px] bg-[#5c0617] text-[#ecec53] text-sm font-black w-9 h-9 rounded-full flex items-center justify-center border-2 border-[#fff5ec] shadow-lg transition-all duration-300 group-hover:scale-125 group-hover:bg-[#e05263] group-hover:rotate-12">
            3
          </span>
        </div>
        <div class="absolute -bottom-10 left-0 md:right-0 md:left-auto opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none z-30 group-hover:translate-y-1">
          <span class="bg-[#5c0617] text-[#ecec53] font-['Space_Grotesk',sans-serif] text-xs md:text-sm font-bold px-4 py-2 rounded-xl border-2 border-[#ecec53] whitespace-nowrap shadow-[4px_4px_0px_#5c0617]">
            Cafec Abaca & T-90 Paper Filters
          </span>
        </div>
      </div>

      <div class="gear-item group sfx-trigger absolute right-[5%] bottom-[5%] md:right-[10%] md:top-[36%] md:bottom-auto w-[140px] md:w-[250px] lg:w-[290px] cursor-pointer z-10 animate-float-delayed">
        <div class="relative transition-all duration-500 ease-out group-hover:scale-115 group-hover:rotate-0 -rotate-15">
          <img src="/mineral.webp" alt="Water Minerals" loading="lazy" decoding="async" class="w-full h-auto filter drop-shadow-[0_15px_25px_rgba(0,0,0,0.35)] select-none" />
          <span class="absolute top-[10px] left-[10px] bg-[#5c0617] text-[#ecec53] text-sm font-black w-9 h-9 rounded-full flex items-center justify-center border-2 border-[#fff5ec] shadow-lg transition-all duration-300 group-hover:scale-125 group-hover:bg-[#e05263] group-hover:rotate-12">
            4
          </span>
        </div>
        <div class="absolute -bottom-10 right-0 opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none z-30 group-hover:translate-y-1">
          <span class="bg-[#5c0617] text-[#ecec53] font-['Space_Grotesk',sans-serif] text-xs md:text-sm font-bold px-4 py-2 rounded-xl border-2 border-[#ecec53] whitespace-nowrap shadow-[4px_4px_0px_#5c0617]">
            Kromatik Tint Water Minerals Mix
          </span>
        </div>
      </div>

    </div>

  </section>

  <div class="overflow-hidden border-t-4 border-[#5c0617] bg-[#ecec53] py-3 flex items-center select-none w-full">
    <div class="marquee-track flex whitespace-nowrap">
      <div class="marquee-group flex gap-12 font-['Space_Grotesk',sans-serif] font-bold text-xl md:text-2xl text-[#5c0617] tracking-widest uppercase pr-12">
        <span>POUR OVER ENTHUSIAST ☕</span>
        <span>HARIO SWITCH 🍎</span>
        <span>TIMEMORE S3 🍊</span>
        <span>FRUITY COFFEE CLUB 🍍</span>
        <span>LIGHT ROAST ONLY 🍑</span>
      </div>
      <div class="marquee-group flex gap-12 font-['Space_Grotesk',sans-serif] font-bold text-xl md:text-2xl text-[#5c0617] tracking-widest uppercase pr-12" aria-hidden="true">
        <span>POUR OVER ENTHUSIAST ☕</span>
        <span>HARIO SWITCH 🍎</span>
        <span>TIMEMORE S3 🍊</span>
        <span>FRUITY COFFEE CLUB 🍍</span>
        <span>LIGHT ROAST ONLY 🍑</span>
      </div>
    </div>
  </div>

  <section id="recipes-section" class="min-h-screen border-t-4 border-[#5c0617] py-20 flex flex-col justify-center polkadot-bg relative overflow-hidden custom-cursor">
    
    <div class="absolute bottom-16 left-12 z-20 animate-float-delayed hidden md:block">
      <div class="sticker-pop bg-[#e05263] text-white border-4 border-[#5c0617] font-black px-4 py-2 rounded-2xl -rotate-6 shadow-[4px_4px_0px_#5c0617] cursor-pointer select-none">
        93°C WATER 💧
      </div>
    </div>

    <div class="anim-on-scroll px-6 md:px-20 mb-4">
      <h2 class="font-['DM_Serif_Display',serif] text-5xl md:text-7xl text-[#5c0617] mb-4 hover:translate-x-2 transition-transform duration-300 cursor-default">
        Brewing Recipes
      </h2>
      <p class="font-['Space_Grotesk',sans-serif] text-lg font-bold text-[#e05263] uppercase tracking-widest">
        Geser & klik untuk lihat parameter ➔
      </p>
    </div>

    <div 
      id="recipes-carousel" 
      class="anim-on-scroll flex overflow-x-auto snap-x snap-mandatory gap-6 md:gap-12 px-[15vw] md:px-[40vw] py-12 hide-scrollbar w-full items-center cursor-grab active:cursor-grabbing scroll-smooth z-10"
    >
      {allRecipes.map((recipe, i) => (
        <div 
          class={`recipe-card sfx-trigger snap-center shrink-0 w-[290px] md:w-[370px] bg-[#fff5ec] border-4 border-[#5c0617] rounded-[2.5rem] p-6 md:p-8 cursor-pointer transition-all duration-300 ease-out flex flex-col justify-between ${i % 2 === 0 ? 'hover:rotate-2' : 'hover:-rotate-2'}`}
          data-title={recipe.data.title}
          data-dripper={recipe.data.dripper}
          data-ratio={recipe.data.ratio}
          data-watertemp={recipe.data.waterTemp}
          data-grindsize={recipe.data.grindSize}
          data-instructions={recipe.body}
        >
          <div>
            <div class="bg-[#ecec53] text-[#5c0617] text-xs font-bold px-4 py-1.5 rounded-full w-fit mb-6 border-2 border-[#5c0617] transition-transform duration-300 hover:scale-110">
              {recipe.data.dripper}
            </div>
            
            <h3 class="font-['DM_Serif_Display',serif] text-3xl md:text-4xl leading-tight mb-4 text-[#5c0617]">
              {recipe.data.title}
            </h3>
          </div>

          <div class="mt-8 border-t-2 border-[#5c0617]/20 pt-4 flex items-center justify-between group">
            <span class="font-bold text-xs uppercase tracking-widest text-[#e05263] group-hover:translate-x-1 transition-transform">Buka Resep</span>
            <span class="text-xl group-hover:translate-x-2 transition-transform">➔</span>
          </div>
        </div>
      ))}
    </div>

    <div class="anim-on-scroll flex justify-center gap-6 mt-6 z-20">
      <button id="recipes-prev" class="btn-playful sfx-trigger bg-[#fff5ec] text-[#5c0617] border-4 border-[#5c0617] w-12 h-12 md:w-14 md:h-14 rounded-full font-black shadow-[4px_4px_0px_#5c0617] hover:bg-[#ecec53] hover:translate-y-1 hover:shadow-none transition-all flex items-center justify-center cursor-pointer select-none">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
      </button>
      <button id="recipes-next" class="btn-playful sfx-trigger bg-[#fff5ec] text-[#5c0617] border-4 border-[#5c0617] w-12 h-12 md:w-14 md:h-14 rounded-full font-black shadow-[4px_4px_0px_#5c0617] hover:bg-[#ecec53] hover:translate-y-1 hover:shadow-none transition-all flex items-center justify-center cursor-pointer select-none">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </button>
    </div>

  </section>

  <!-- FOOTER DENGAN BACKGROUND VIDEO -->
  <footer 
    id="footer-section" 
    class="min-h-[60vh] border-t-4 border-[#5c0617] py-16 px-6 md:px-20 relative flex flex-col justify-between items-center overflow-hidden custom-cursor"
  >
    <video 
      autoplay 
      loop 
      muted 
      playsinline 
      preload="auto"
      class="absolute inset-0 w-full h-full object-cover object-bottom z-0 pointer-events-none"
    >
      <source src="/walk.mp4" type="video/mp4" />
      <source src="/walking.webm" type="video/webm" />
      Browser kamu tidak mendukung tag video.
    </video>

    <div class="absolute inset-0 bg-black/10 z-0 pointer-events-none"></div>

    <div class="absolute bottom-4 left-1/2 -translate-x-1/2 z-10 text-[#5c0617] font-bold">
      <p class="bg-[#fff5ec]/90 px-4 py-2 border-2 border-[#5c0617] rounded-xl shadow-[4px_4px_0px_#5c0617] whitespace-nowrap">© 2026 Fruity Coffee Club</p>
    </div>
  </footer>

  <div id="bean-modal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4">
    <div id="modal-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm cursor-pointer opacity-0 transition-opacity duration-300"></div>
    
    <div id="modal-content" class="relative bg-[#fff5ec] border-4 border-[#5c0617] rounded-[2rem] shadow-[12px_12px_0px_#5c0617] p-8 md:p-12 max-w-2xl w-full max-h-[90vh] overflow-y-auto transform scale-95 opacity-0 transition-all duration-300 hide-scrollbar">
      
      <button id="close-modal" class="sfx-trigger absolute top-6 right-6 bg-[#e05263] text-white border-2 border-[#5c0617] w-12 h-12 rounded-full font-bold shadow-[4px_4px_0px_#5c0617] hover:rotate-90 hover:scale-110 hover:shadow-none transition-all duration-300 flex items-center justify-center text-xl">
        X
      </button>

      <h2 id="modal-name" class="font-['DM_Serif_Display',serif] text-4xl md:text-5xl mb-8 text-[#5c0617] pr-12 leading-tight"></h2>
      
      <div class="mb-8 pb-8 border-b-2 border-[#5c0617]/20">
        <h3 class="font-bold text-xl md:text-2xl text-[#5c0617] mb-4">Beans Info</h3>
        <ul class="space-y-2 font-['Space_Grotesk',sans-serif] text-lg text-[#5c0617]">
          <li><strong>• Origin:</strong> <span id="modal-origin"></span></li>
          <li><strong>• Process:</strong> <span id="modal-process"></span></li>
          <li><strong>• Roaster:</strong> <span id="modal-roaster"></span></li>
          <li><strong>• Notes:</strong> <span id="modal-notes" class="text-[#e05263] font-bold"></span></li>
        </ul>
      </div>
      
      <div>
        <h3 class="font-bold text-xl md:text-2xl text-[#5c0617] mb-2">My Thoughts</h3>
        <div id="modal-review" class="font-['Space_Grotesk',sans-serif] text-[#5c0617] mt-3 leading-relaxed text-lg"></div>
      </div>
    </div>
  </div>

  <div id="recipe-modal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4">
    <div id="recipe-modal-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm cursor-pointer opacity-0 transition-opacity duration-300"></div>
    
    <div id="recipe-modal-content" class="relative bg-[#fff5ec] border-4 border-[#5c0617] rounded-[2rem] shadow-[12px_12px_0px_#5c0617] p-8 md:p-12 max-w-2xl w-full max-h-[90vh] overflow-y-auto transform scale-95 opacity-0 transition-all duration-300 hide-scrollbar">
      
      <button id="recipe-close-modal" class="sfx-trigger absolute top-6 right-6 bg-[#e05263] text-white border-2 border-[#5c0617] w-12 h-12 rounded-full font-bold shadow-[4px_4px_0px_#5c0617] hover:rotate-90 hover:scale-110 hover:shadow-none transition-all duration-300 flex items-center justify-center text-xl">
        X
      </button>

      <div id="recipe-modal-dripper" class="bg-[#ecec53] text-[#5c0617] text-xs font-bold px-4 py-1.5 rounded-full w-fit mb-6 border-2 border-[#5c0617]"></div>
      <h2 id="recipe-modal-title" class="font-['DM_Serif_Display',serif] text-4xl md:text-5xl mb-8 text-[#5c0617] pr-12 leading-tight"></h2>
      
      <div class="mb-8 pb-8 border-b-2 border-[#5c0617]/20">
        <h3 class="font-bold text-xl md:text-2xl text-[#5c0617] mb-4">Brew Parameters</h3>
        <ul class="space-y-2 font-['Space_Grotesk',sans-serif] text-lg text-[#5c0617]">
          <li><strong>• Ratio:</strong> <span id="recipe-modal-ratio"></span></li>
          <li><strong>• Water Temp:</strong> <span id="recipe-modal-watertemp"></span></li>
          <li><strong>• Grind Size:</strong> <span id="recipe-modal-grindsize" class="text-[#e05263] font-bold"></span></li>
        </ul>
      </div>

      <div class="mb-8 p-5 bg-[#ecec53] border-4 border-[#5c0617] rounded-2xl shadow-[6px_6px_0px_#5c0617]">
        <h4 class="font-['Space_Grotesk',sans-serif] font-black text-base text-[#5c0617] uppercase tracking-wider mb-3 flex items-center gap-2">
          ⚙️ Interactive Recipe & Dose Calculator
        </h4>
        <div class="flex flex-col gap-3 font-['Space_Grotesk',sans-serif] text-xs md:text-sm text-[#5c0617]">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <div class="flex items-center justify-between gap-2">
              <label for="target-water-input" class="font-bold">Total Air (ml):</label>
              <input id="target-water-input" type="number" value="250" step="10" min="100" max="1000" class="w-24 px-2 py-1 font-bold text-center border-2 border-[#5c0617] rounded-lg bg-[#fff5ec]" />
