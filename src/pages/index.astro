<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

<script>
  import { marked } from 'https://cdn.jsdelivr.net/npm/marked/lib/marked.esm.js';

  // WEB AUDIO API SYNTHESIZER
  const audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
  function playPopSound() {
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    
    osc.type = 'sine';
    osc.frequency.setValueAtTime(400, audioCtx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(800, audioCtx.currentTime + 0.08);
    
    gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.08);
    
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    
    osc.start();
    osc.stop(audioCtx.currentTime + 0.08);
  }

  document.querySelectorAll('.sfx-trigger, .sticker-pop').forEach(el => {
    el.addEventListener('click', playPopSound);
  });

  // EASTER EGG CONFETTI
  let clickCount = 0;
  function triggerConfetti(e: MouseEvent) {
    clickCount++;
    playPopSound();
    if (clickCount >= 5) {
      if ((window as any).confetti) {
        (window as any).confetti({
          particleCount: 120,
          spread: 80,
          origin: { y: 0.6 }
        });
      }
      clickCount = 0;
    }
  }

  const pineappleMascot = document.getElementById('pineapple-mascot');
  if (pineappleMascot) pineappleMascot.addEventListener('click', triggerConfetti);
  document.querySelectorAll('.sticker-pop').forEach(stk => stk.addEventListener('click', triggerConfetti));

  // INTERACTIVE BREW RECIPE & PARAMETER CALCULATOR LOGIC
  const waterInput = document.getElementById('target-water-input') as HTMLInputElement;
  const ratioSelect = document.getElementById('brew-ratio-select') as HTMLSelectElement;
  const processSelect = document.getElementById('bean-process-select') as HTMLSelectElement;

  const doseRes = document.getElementById('coffee-dose-res');
  const tempRes = document.getElementById('ideal-temp-res');
  const timeRes = document.getElementById('brew-time-res');

  function updateRecipeCalculator() {
    if (!waterInput || !ratioSelect || !processSelect) return;
    
    const water = parseFloat(waterInput.value) || 0;
    const ratio = parseFloat(ratioSelect.value) || 15.5;
    const process = processSelect.value;

    const dose = water / ratio;
    if (doseRes) doseRes.innerText = `${dose.toFixed(1)} g`;

    let temp = '92°C';
    let time = '02:30';

    if (process === 'washed') {
      temp = '94°C';
      time = '02:15';
    } else if (process === 'anaerobic') {
      temp = '91°C';
      time = '02:45';
    } else if (process === 'giling-basah') {
      temp = '93°C';
      time = '02:20';
    } else if (process === 'natural') {
      temp = '90°C';
      time = '02:30';
    }

    if (tempRes) tempRes.innerText = temp;
    if (timeRes) timeRes.innerText = time;
  }

  if (waterInput && ratioSelect && processSelect) {
    waterInput.addEventListener('input', updateRecipeCalculator);
    ratioSelect.addEventListener('change', updateRecipeCalculator);
    processSelect.addEventListener('change', updateRecipeCalculator);
  }

  // ANIMASI PRELOADER
  const loaderOverlay = document.getElementById('loader-overlay');
  const hiText = document.getElementById('hi-there-text');

  if (loaderOverlay && pineappleMascot) {
    document.body.style.overflow = 'hidden';

    setTimeout(() => {
      pineappleMascot.classList.remove('scale-90');
      pineappleMascot.classList.add('scale-125');
    }, 400);

    setTimeout(() => {
      loaderOverlay.style.transform = 'translateY(-100%)';
      document.body.style.overflow = '';
      
      if (hiText) {
        hiText.classList.remove('scale-90', 'opacity-0');
        hiText.classList.add('scale-100', 'opacity-100');
      }
    }, 900);
  }

  // REUSABLE SWIPE FOCUS CAROUSEL LOGIC
  function setupCarouselFocus(carouselId: string, cardClass: string, prevBtnId?: string, nextBtnId?: string) {
    const carousel = document.getElementById(carouselId);
    const cards = carousel?.querySelectorAll(cardClass);
    const prevBtn = prevBtnId ? document.getElementById(prevBtnId) : null;
    const nextBtn = nextBtnId ? document.getElementById(nextBtnId) : null;

    if (!carousel || !cards || cards.length === 0) return;

    function updateFocus() {
      const carouselRect = carousel.getBoundingClientRect();
      const carouselCenter = carouselRect.left + carouselRect.width / 2;

      cards.forEach((card) => {
        const el = card as HTMLElement;
        const cardRect = el.getBoundingClientRect();
        const cardCenter = cardRect.left + cardRect.width / 2;
        const distanceFromCenter = Math.abs(carouselCenter - cardCenter);

        if (distanceFromCenter < 180) {
          el.style.transform = 'scale(1.08) translateY(-16px)';
          el.style.opacity = '1';
          el.style.filter = 'blur(0px)';
          el.style.boxShadow = '12px 12px 0px #e05263';
          el.style.zIndex = '20';
        } else {
          el.style.transform = 'scale(0.88) translateY(0px)';
          el.style.opacity = '0.55';
          el.style.filter = 'blur(2.5px)';
          el.style.boxShadow = '8px 8px 0px #5c0617';
          el.style.zIndex = '10';
        }
      });
    }

    carousel.addEventListener('scroll', updateFocus);

    const scrollAmount = 320;
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      });
    }

    let isDown = false;
    let startX: number;
    let scrollLeft: number;

    carousel.addEventListener('mousedown', (e) => {
      isDown = true;
      startX = e.pageX - carousel.offsetLeft;
      scrollLeft = carousel.scrollLeft;
    });
    carousel.addEventListener('mouseleave', () => { isDown = false; });
    carousel.addEventListener('mouseup', () => { isDown = false; });
    carousel.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - carousel.offsetLeft;
      const walk = (x - startX) * 1.5;
      carousel.scrollLeft = scrollLeft - walk;
    });

    setTimeout(updateFocus, 200);
    window.addEventListener('resize', updateFocus);
  }

  setupCarouselFocus('beans-carousel', '.bean-card', 'beans-prev', 'beans-next');
  setupCarouselFocus('recipes-carousel', '.recipe-card', 'recipes-prev', 'recipes-next');

  // Animasi Font Hero
  const textElement = document.getElementById('hi-there-text');
  const fonts = [
    "'Space Grotesk', sans-serif", "'DM Serif Display', serif", "'Syne', sans-serif",
    "'Bebas Neue', sans-serif", "'Space Mono', monospace", "'Abril Fatface', serif", "'Permanent Marker', cursive"
  ];
  let currentIndex = 0;
  setInterval(() => {
    currentIndex = (currentIndex + 1) % fonts.length;
    if (textElement) textElement.style.fontFamily = fonts[currentIndex];
  }, 400);

  // Intersection Observer
  const observerOptions = { root: null, rootMargin: '0px', threshold: 0.15 };
  const observer = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target); 
      }
    });
  }, observerOptions);
  document.querySelectorAll('.anim-on-scroll').forEach(el => observer.observe(el));

  // Modal Beans
  const beanCardsList = document.querySelectorAll('.bean-card');
  const modal = document.getElementById('bean-modal');
  const modalBackdrop = document.getElementById('modal-backdrop');
  const modalContent = document.getElementById('modal-content');
  const closeModal = document.getElementById('close-modal');

  const mName = document.getElementById('modal-name');
  const mOrigin = document.getElementById('modal-origin');
  const mProcess = document.getElementById('modal-process');
  const mRoaster = document.getElementById('modal-roaster');
  const mNotes = document.getElementById('modal-notes');
  const mReview = document.getElementById('modal-review');

  function openModal(data: any) {
    if(mName) mName.innerText = data.name;
    if(mOrigin) mOrigin.innerText = data.origin;
    if(mProcess) mProcess.innerText = data.process;
    if(mRoaster) mRoaster.innerText = data.roaster;
    if(mNotes) mNotes.innerText = data.notes;
    if(mReview) mReview.innerHTML = marked.parse(data.review);

    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
    document.body.style.overflow = 'hidden';
    
    setTimeout(() => {
      modalBackdrop?.classList.remove('opacity-0');
      modalBackdrop?.classList.add('opacity-100');
      modalContent?.classList.remove('scale-95', 'opacity-0');
      modalContent?.classList.add('scale-100', 'opacity-100');
    }, 10);
  }

  function close() {
    modalBackdrop?.classList.remove('opacity-100');
    modalBackdrop?.classList.add('opacity-0');
    modalContent?.classList.remove('scale-100', 'opacity-100');
    modalContent?.classList.add('scale-95', 'opacity-0');
    setTimeout(() => {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
      document.body.style.overflow = '';
    }, 300);
  }

  beanCardsList.forEach(card => card.addEventListener('click', () => openModal((card as HTMLElement).dataset)));
  if(closeModal) closeModal.addEventListener('click', close);
  if(modalBackdrop) modalBackdrop.addEventListener('click', close);

  // Modal Recipes
  const recipeCards = document.querySelectorAll('.recipe-card');
  const recipeModal = document.getElementById('recipe-modal');
  const recipeModalBackdrop = document.getElementById('recipe-modal-backdrop');
  const recipeModalContent = document.getElementById('recipe-modal-content');
  const recipeCloseModal = document.getElementById('recipe-close-modal');

  const rTitle = document.getElementById('recipe-modal-title');
  const rDripper = document.getElementById('recipe-modal-dripper');
  const rRatio = document.getElementById('recipe-modal-ratio');
  const rWaterTemp = document.getElementById('recipe-modal-watertemp');
  const rGrindSize = document.getElementById('recipe-modal-grindsize');
  const rInstructions = document.getElementById('recipe-modal-instructions');

  function openRecipeModal(data: any) {
    if(rTitle) rTitle.innerText = data.title;
    if(rDripper) rDripper.innerText = data.dripper;
    if(rRatio) rRatio.innerText = data.ratio;
    if(rWaterTemp) rWaterTemp.innerText = data.watertemp;
    if(rGrindSize) rGrindSize.innerText = data.grindsize;
    if(rInstructions) rInstructions.innerHTML = marked.parse(data.instructions);

    updateRecipeCalculator();

    recipeModal?.classList.remove('hidden');
    recipeModal?.classList.add('flex');
    document.body.style.overflow = 'hidden';
    
    setTimeout(() => {
      recipeModalBackdrop?.classList.remove('opacity-0');
      recipeModalBackdrop?.classList.add('opacity-100');
      recipeModalContent?.classList.remove('scale-95', 'opacity-0');
      recipeModalContent?.classList.add('scale-100', 'opacity-100');
    }, 10);
  }

  function closeRecipe() {
    recipeModalBackdrop?.classList.remove('opacity-100');
    recipeModalBackdrop?.classList.add('opacity-0');
    recipeModalContent?.classList.remove('scale-100', 'opacity-100');
    recipeModalContent?.classList.add('scale-95', 'opacity-0');
    setTimeout(() => {
      recipeModal?.classList.add('hidden');
      recipeModal?.classList.remove('flex');
      document.body.style.overflow = '';
    }, 300);
  }

  recipeCards.forEach(card => card.addEventListener('click', () => openRecipeModal((card as HTMLElement).dataset)));
  if(recipeCloseModal) recipeCloseModal.addEventListener('click', closeRecipe);
  if(recipeModalBackdrop) recipeModalBackdrop.addEventListener('click', closeRecipe);
</script>

<style>
  html { scroll-behavior: smooth; }
  
  .hide-scrollbar::-webkit-scrollbar { display: none; }
  .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

  /* CUSTOM PLAYFUL NANAS CURSOR */
  .custom-cursor {
    cursor: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewBox='0 0 24 24'><text y='20' font-size='20'>🍍</text></svg>"), auto;
  }

  /* STICKER HOVER POP ANIMATION */
  .sticker-pop {
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .sticker-pop:hover {
    transform: scale(1.25) rotate(0deg) !important;
  }

  /* Polkadot Background Pattern */
  .polkadot-bg {
    background-color: #f8e5d6;
    background-image: radial-gradient(rgba(92, 6, 23, 0.25) 5%, transparent 0.5%);
    background-size: 24px 24px;
    background-position: 0 0;
  }

  /* Animasi Fade-in Scroll Smooth & Bouncy */
  .anim-on-scroll {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.8s cubic-bezier(0.34, 1.56, 0.64, 1), transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
    will-change: opacity, transform;
  }
  .anim-on-scroll.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Animasi Hero Text Reveal */
  #hi-there-text {
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ANIMASI RUNNING TEXT SEAMLESS */
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marqueeLoop 22s linear infinite;
  }
  .marquee-track-reverse {
    display: flex;
    width: max-content;
    animation: marqueeLoopReverse 22s linear infinite;
  }

  @keyframes marqueeLoop {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }
  @keyframes marqueeLoopReverse {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0%); }
  }

  /* Animasi Floating Melayang */
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-12px); }
  }
  @keyframes floatDelayed {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-12px); }
  }
  .animate-float {
    animation: float 4s ease-in-out infinite;
  }
  .animate-float-delayed {
    animation: floatDelayed 4.5s ease-in-out infinite 1.5s;
  }

  /* Playful Button Active Scale */
  .btn-playful:active {
    transform: scale(0.9) translateY(2px);
  }

  /* Styling Markdown Render */
  #recipe-modal-instructions p, #modal-review p { margin-bottom: 1rem; }
  #recipe-modal-instructions h3 {
    font-family: 'DM Serif Display', serif;
    font-size: 1.5rem;
    color: #5c0617;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  #recipe-modal-instructions ol {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  #recipe-modal-instructions ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }
  #recipe-modal-instructions strong, #modal-review strong {
    color: #e05263;
    font-weight: 800;
  }

  .gear-item {
    will-change: transform;
  }
</style>