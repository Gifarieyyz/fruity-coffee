              <select id="brew-ratio-select" class="w-24 px-2 py-1 font-bold text-center border-2 border-[#5c0617] rounded-lg bg-[#fff5ec]">
                <option value="15">1 : 15</option>
                <option value="15.5" selected>1 : 15.5</option>
                <option value="16">1 : 16</option>
                <option value="16.5">1 : 16.5</option>
