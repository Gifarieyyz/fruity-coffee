              <span class="block text-[10px] uppercase font-bold text-[#e05263]">Dosis Kopi</span>
              <span id="coffee-dose-res" class="font-black text-sm md:text-base">16.1 g</span>
            </div>
            <div class="bg-[#fff5ec] p-2 rounded-xl border-2 border-[#5c0617]">
              <span class="block text-[10px] uppercase font-bold text-[#5c0617]">Suhu Air</span>
              <span id="ideal-temp-res" class="font-black text-sm md:text-base">92°C</span>
            </div>
